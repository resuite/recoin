{
   "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
   "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
   },
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3,
      "bracketSpacing": true,
      "lineWidth": 100
   },
   "javascript": {
      "globals": ["google"],
      "formatter": {
         "quoteStyle": "single",
         "jsxQuoteStyle": "single",
         "arrowParentheses": "always",
         "trailingCommas": "none",
         "semicolons": "asNeeded"
      }
   },
   "assist": {
      "actions": {
         "source": {
            "organizeImports": "on"
         }
      }
   },
   "css": {
      "formatter": {
         "quoteStyle": "double"
      },
      "parser": {
         "tailwindDirectives": true
      }
   },
   "linter": {
      "enabled": true,
      "includes": ["**", "!**/base.css"],
      "rules": {
         "nursery": {},
         "style": {
            "useBlockStatements": "error",
            "useConsistentArrayType": {
               "level": "error",
               "options": {
                  "syntax": "generic"
               }
            },
            "noNestedTernary": "error"
         },
         "suspicious": {
            "useAwait": "error",
            "noConsole": "error"
         },
         "correctness": {
            "noUnusedVariables": "error",
            "noUnusedFunctionParameters": "error",
            "noUnusedImports": "error",
            "noUndeclaredVariables": "error"
         },
         "a11y": {
            "noLabelWithoutControl": {
               "level": "error",
               "options": {
                  "inputComponents": ["Input", "_Input"],
                  "labelAttributes": ["label"]
               }
            }
         }
      }
   }
}
